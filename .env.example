# Copy to .env (gitignored) and start with ./run.sh. Empty values count as unset,
# so a copied example starts with sign-in off.

# OAuth client from Google Cloud; set all four sign-in variables or none.
SONAR_GOOGLE_CLIENT_ID=
SONAR_GOOGLE_CLIENT_SECRET=
# Signs the session cookie: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SONAR_SESSION_SECRET=
# http://127.0.0.1:8000 (127.0.0.1, not localhost; the port must match SONAR_PORT)
SONAR_BASE_URL=

# Optional bearer token for /api/* when sign-in is on.
SONAR_API_TOKEN=

SONAR_DB_PATH=data/sonar.db
SONAR_PORT=8000

# Comma-separated; synced into the access list on every run.sh start: owner@example.com,partner@example.com
SONAR_ALLOWED_EMAILS=

# Enable Banking (Deutsche Bank sync); set both or neither.
# The application id from the Enable Banking control panel.
SONAR_ENABLE_BANKING_APP_ID=
# Path to the application's private key .pem, outside the repo, mode 600.
SONAR_ENABLE_BANKING_KEY_PATH=
