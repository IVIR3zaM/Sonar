server {
    listen 443 ssl;
    server_name ${hostname};

    # Self-signed origin certificate; Cloudflare terminates the public TLS.
    ssl_certificate     /etc/sonar/tls/origin.crt;
    ssl_certificate_key /etc/sonar/tls/origin.key;

    # Bank exports are uploaded through the import page.
    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
